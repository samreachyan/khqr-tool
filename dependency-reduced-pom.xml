<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.ftb</groupId>
  <artifactId>decodekhqr</artifactId>
  <name>decodekhqr</name>
  <version>1.0.0</version>
  <build>
    <plugins>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.6.0</version>
        <configuration>
          <source>17</source>
          <target>17</target>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-maven-plugin</artifactId>
        <version>0.0.8</version>
        <executions>
          <execution>
            <id>default-cli</id>
            <configuration>
              <mainClass>com.sakcode.decodekhqr.MainKHQRApplication</mainClass>
              <launcher>app</launcher>
              <jlinkZipName>app</jlinkZipName>
              <jlinkImageName>app</jlinkImageName>
              <noManPages>true</noManPages>
              <stripDebug>true</stripDebug>
              <noHeaderFiles>true</noHeaderFiles>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.2.0</version>
        <configuration>
          <archive>
            <manifest>
              <addClasspath>true</addClasspath>
              <classpathPrefix>lib/</classpathPrefix>
              <mainClass>com.sakcode.decodekhqr.MainKHQRApplication</mainClass>
            </manifest>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <transformers>
                <transformer>
                  <mainClass>com.sakcode.decodekhqr.MainKHQRApplication</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.panteleyev</groupId>
        <artifactId>jpackage-maven-plugin</artifactId>
        <version>${jpackage.maven.plugin.version}</version>
        <executions>
          <execution>
            <id>jpackage-linux-deb</id>
            <phase>package</phase>
            <goals>
              <goal>jpackage</goal>
            </goals>
            <configuration>
              <type>deb</type>
              <jpackageHome>${env.JAVA_HOME}</jpackageHome>
            </configuration>
          </execution>
          <execution>
            <id>jpackage-linux-rpm</id>
            <phase>package</phase>
            <goals>
              <goal>jpackage</goal>
            </goals>
            <configuration>
              <type>rpm</type>
              <jpackageHome>${env.JAVA_HOME}</jpackageHome>
            </configuration>
          </execution>
          <execution>
            <id>jpackage-windows</id>
            <phase>package</phase>
            <goals>
              <goal>jpackage</goal>
            </goals>
            <configuration>
              <type>msi</type>
              <jpackageHome>${env.JAVA_HOME}</jpackageHome>
            </configuration>
          </execution>
          <execution>
            <id>jpackage-macos</id>
            <phase>package</phase>
            <goals>
              <goal>jpackage</goal>
            </goals>
            <configuration>
              <type>dmg</type>
              <jpackageHome>${env.JAVA_HOME}</jpackageHome>
            </configuration>
          </execution>
        </executions>
        <configuration>
          <name>${app.name}</name>
          <appVersion>${app.version}</appVersion>
          <vendor>${app.vendor}</vendor>
          <description>${app.description}</description>
          <copyright>Copyright © 2024 ${app.vendor}</copyright>
          <licenseFile>LICENSE</licenseFile>
          <mainClass>${main.class}</mainClass>
          <mainJar>${project.build.finalName}.jar</mainJar>
          <icon>${app.icon.linux}</icon>
          <linuxIcon>${app.icon.linux}</linuxIcon>
          <winIcon>${app.icon.windows}</winIcon>
          <macIcon>${app.icon.macos}</macIcon>
          <linuxPackageName>${project.artifactId}</linuxPackageName>
          <linuxMenuGroup>${app.vendor}</linuxMenuGroup>
          <linuxAppCategory>Utility</linuxAppCategory>
          <linuxShortcut>true</linuxShortcut>
          <winMenu>true</winMenu>
          <winMenuGroup>${app.vendor}</winMenuGroup>
          <winShortcut>true</winShortcut>
          <winPerUserInstall>true</winPerUserInstall>
          <winDirChooser>true</winDirChooser>
          <macPackageName>${app.name}</macPackageName>
          <macCategory>public.app-category.utilities</macCategory>
          <macSign>false</macSign>
          <javaOptions>
            <option>-Dfile.encoding=UTF-8</option>
            <option>-Xmx512m</option>
          </javaOptions>
          <resourceDir>${project.basedir}/src/main/resources</resourceDir>
          <destination>${project.build.directory}/jpackage</destination>
        </configuration>
      </plugin>
    </plugins>
  </build>
  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
      <version>5.10.0</version>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <artifactId>opentest4j</artifactId>
          <groupId>org.opentest4j</groupId>
        </exclusion>
        <exclusion>
          <artifactId>junit-platform-commons</artifactId>
          <groupId>org.junit.platform</groupId>
        </exclusion>
        <exclusion>
          <artifactId>apiguardian-api</artifactId>
          <groupId>org.apiguardian</groupId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-engine</artifactId>
      <version>5.10.0</version>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <artifactId>junit-platform-engine</artifactId>
          <groupId>org.junit.platform</groupId>
        </exclusion>
        <exclusion>
          <artifactId>apiguardian-api</artifactId>
          <groupId>org.apiguardian</groupId>
        </exclusion>
      </exclusions>
    </dependency>
  </dependencies>
  <properties>
    <app.icon.macos>src/main/resources/icon_1024.icns</app.icon.macos>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <javafx.version>21</javafx.version>
    <app.icon.linux>src/main/resources/icon_64.png</app.icon.linux>
    <junit.version>5.10.0</junit.version>
    <app.name>KHQR Tool</app.name>
    <main.class>com.sakcode.decodekhqr.MainKHQRApplication</main.class>
    <maven.compiler.source>17</maven.compiler.source>
    <javafx.maven.plugin.version>0.0.8</javafx.maven.plugin.version>
    <app.version>${project.version}</app.version>
    <app.vendor>Sakcode</app.vendor>
    <app.description>KHQR Code Generator and Decoder</app.description>
    <app.icon.windows>src/main/resources/icon-khqr.ico</app.icon.windows>
    <maven.compiler.target>17</maven.compiler.target>
    <jpackage.maven.plugin.version>1.6.2</jpackage.maven.plugin.version>
  </properties>
</project>
