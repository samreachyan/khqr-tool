<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.ftb</groupId>
    <artifactId>decodekhqr</artifactId>
    <version>1.0.1</version>
    <name>decodekhqr</name>
    <packaging>jar</packaging>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>5.10.0</junit.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <javafx.version>21</javafx.version>
        <javafx.maven.plugin.version>0.0.8</javafx.maven.plugin.version>
        <jpackage.maven.plugin.version>1.6.2</jpackage.maven.plugin.version>
        <main.class>com.sakcode.decodekhqr.MainKHQRApplication</main.class>
        <app.name>KHQR Tool</app.name>
        <app.vendor>Sakcode</app.vendor>
        <app.description>KHQR Code Generator and Decoder</app.description>
        <app.version>${project.version}</app.version>
        <app.icon.linux>src/main/resources/icon_64.png</app.icon.linux>
        <app.icon.macos>src/main/resources/icon_1024.icns</app.icon.macos>
        <app.icon.windows>src/main/resources/icon-khqr.ico</app.icon.windows>
        <!-- Skip properties for platform-specific builds -->
        <skip.linux>true</skip.linux>
        <skip.linux.deb>${skip.linux}</skip.linux.deb>
        <skip.linux.rpm>${skip.linux}</skip.linux.rpm>
        <skip.windows>true</skip.windows>
        <skip.macos>false</skip.macos>
    </properties>

    <dependencies>
        <!-- Source: https://mvnrepository.com/artifact/org.apache.commons/commons-lang3 -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
            <version>3.20.0</version>
        </dependency>
        <!-- https://mvnrepository.com/artifact/com.fasterxml.jackson.core/jackson-databind -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.18.3</version>
        </dependency>
        <!-- https://mvnrepository.com/artifact/kh.org.nbc.bakong_khqr/sdk-java -->
        <dependency>
            <groupId>kh.gov.nbc.bakong_khqr</groupId>
            <artifactId>sdk-java</artifactId>
            <version>1.0.0.16</version>
        </dependency>
        <!-- https://mvnrepository.com/artifact/com.google.zxing/core -->
        <dependency>
            <groupId>com.google.zxing</groupId>
            <artifactId>core</artifactId>
            <version>3.5.3</version>
        </dependency>
        <!-- https://mvnrepository.com/artifact/com.google.zxing/javase -->
        <dependency>
            <groupId>com.google.zxing</groupId>
            <artifactId>javase</artifactId>
            <version>3.5.3</version>
        </dependency>

        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>21</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>17.0.6</version>
        </dependency>
        <dependency>
            <groupId>org.controlsfx</groupId>
            <artifactId>controlsfx</artifactId>
            <version>11.1.2</version>
        </dependency>
        <dependency>
            <groupId>org.kordamp.bootstrapfx</groupId>
            <artifactId>bootstrapfx-core</artifactId>
            <version>0.4.0</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.6.0</version>
                <configuration>
                    <source>17</source>
                    <target>17</target>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <executions>
                    <execution>
                        <!-- Default configuration for running with: mvn clean javafx:run -->
                        <id>default-cli</id>
                        <configuration>
                            <mainClass>com.sakcode.decodekhqr.MainKHQRApplication</mainClass>
                            <launcher>app</launcher>
                            <jlinkZipName>app</jlinkZipName>
                            <jlinkImageName>app</jlinkImageName>
                            <noManPages>true</noManPages>
                            <stripDebug>true</stripDebug>
                            <noHeaderFiles>true</noHeaderFiles>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.2.0</version>
                <configuration>
                    <archive>
                        <manifest>
                            <addClasspath>true</addClasspath>
                            <classpathPrefix>lib/</classpathPrefix>
                            <mainClass>com.sakcode.decodekhqr.MainKHQRApplication</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.sakcode.decodekhqr.MainKHQRApplication</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            
            <!-- JPackage plugin for creating native installers -->
            <plugin>
                <groupId>org.panteleyev</groupId>
                <artifactId>jpackage-maven-plugin</artifactId>
                <version>${jpackage.maven.plugin.version}</version>
                <configuration>
                    <name>${app.name}</name>
                    <appVersion>${app.version}</appVersion>
                    <vendor>${app.vendor}</vendor>
                    <description>${app.description}</description>
                    <copyright>Copyright © 2024 ${app.vendor}</copyright>
                    <licenseFile>LICENSE</licenseFile>
                    
                    <!-- Main class configuration -->
                    <mainClass>${main.class}</mainClass>
                    <mainJar>${project.build.finalName}.jar</mainJar>
                    
                    <!-- Platform-specific icon configuration -->
                    <!-- Use general icon parameter, jpackage will handle platform-specific formats -->
                    <icon>${app.icon.macos}</icon>
                    <!-- Also set platform-specific icons as backup -->
                    <linuxIcon>${app.icon.linux}</linuxIcon>
                    <winIcon>${app.icon.windows}</winIcon>
                    <macIcon>${app.icon.macos}</macIcon>
                    
                    <!-- Platform-specific configuration -->
                    <linuxPackageName>${project.artifactId}</linuxPackageName>
                    <linuxMenuGroup>${app.vendor}</linuxMenuGroup>
                    <linuxAppCategory>Utility</linuxAppCategory>
                    <linuxShortcut>true</linuxShortcut>
                    
                    <winMenu>true</winMenu>
                    <winMenuGroup>${app.vendor}</winMenuGroup>
                    <winShortcut>true</winShortcut>
                    <winPerUserInstall>true</winPerUserInstall>
                    <winDirChooser>true</winDirChooser>
                    
                    <macPackageName>${app.name}</macPackageName>
                    <macPackageIdentifier>com.sakcode.decodekhqr</macPackageIdentifier>
                    <macCategory>public.app-category.utilities</macCategory>
                    <macSign>false</macSign> <!-- Set to true for App Store distribution -->
                    <!-- Remove default entitlements that request microphone access -->
                    <macEntitlementsFile></macEntitlementsFile>
                    
                    <!-- Java runtime options -->
                    <javaOptions>
                        <option>-Dfile.encoding=UTF-8</option>
                        <option>-Xmx512m</option>
                    </javaOptions>
                    
                    <!-- JavaFX configuration -->
                    <!-- Liberica JDK includes JavaFX modules -->
                    <!-- For local development with standard JDK, install Liberica JDK Full -->
                    
                    <!-- Resources to include -->
                    <resourceDir>${project.basedir}/src/main/resources</resourceDir>
                    
                    <!-- Input directory with JAR files -->
                    <input>${project.build.directory}</input>
                    
                    <!-- Output directory -->
                    <destination>${project.build.directory}/jpackage</destination>
                </configuration>
                <executions>
                    <execution>
                        <id>jpackage-linux-deb</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jpackage</goal>
                        </goals>
                        <configuration>
                            <type>DEB</type>
                            <jpackageHome>${env.JAVA_HOME}</jpackageHome>
                            <skip>${skip.linux.deb}</skip>
                        </configuration>
                    </execution>
                    <execution>
                        <id>jpackage-linux-rpm</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jpackage</goal>
                        </goals>
                        <configuration>
                            <type>RPM</type>
                            <jpackageHome>${env.JAVA_HOME}</jpackageHome>
                            <skip>${skip.linux.rpm}</skip>
                        </configuration>
                    </execution>
                    <execution>
                        <id>jpackage-windows</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jpackage</goal>
                        </goals>
                        <configuration>
                            <type>MSI</type>
                            <jpackageHome>${env.JAVA_HOME}</jpackageHome>
                            <skip>${skip.windows}</skip>
                        </configuration>
                    </execution>
                    <execution>
                        <id>jpackage-macos</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jpackage</goal>
                        </goals>
                        <configuration>
                            <type>DMG</type>
                            <jpackageHome>${env.JAVA_HOME}</jpackageHome>
                            <skip>${skip.macos}</skip>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!-- Profiles for different JavaFX configurations -->
    <profiles>
        <profile>
            <id>local-javafx-jmods</id>
            <activation>
                <property>
                    <name>javafx.jmods.path</name>
                </property>
            </activation>
            <properties>
                <javafx.module.path>${javafx.jmods.path}</javafx.module.path>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.panteleyev</groupId>
                        <artifactId>jpackage-maven-plugin</artifactId>
                        <configuration>
                            <modulePath>${javafx.module.path}</modulePath>
                            <addModules>
                                <module>javafx.controls</module>
                                <module>javafx.fxml</module>
                                <module>javafx.graphics</module>
                            </addModules>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        
        <profile>
            <id>liberica-jdk</id>
            <activation>
                <property>
                    <name>!javafx.jmods.path</name>
                </property>
            </activation>
            <properties>
                <!-- Liberica JDK includes JavaFX modules -->
            </properties>
        </profile>
    </profiles>

</project>
